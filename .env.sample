# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3050,http://localhost:3030,tauri://localhost

# Database
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=construct
DB_USER=root
DB_PASS=

# Added 2026-09-08 from the deployment's keys
INTERNAL_SHARED_SECRET=change-me
